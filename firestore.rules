rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    // Athletes: anyone signed in can read (leaderboard needs it).
    // Athletes write only their own profile. Demo seeding is allowed for
    // docs flagged demo == true so the "Load demo data" button works, and
    // anyone signed in can delete demo docs (the "Remove demo data" button).
    match /athletes/{uid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (request.auth.uid == uid || request.resource.data.demo == true);
      allow update: if isSignedIn() && request.auth.uid == uid;
      allow delete: if isSignedIn() && resource.data.demo == true;
    }

    // Sessions: anyone signed in can read (feed + board need it).
    // Athletes write only their own sessions. Demo seeding allowed for
    // docs flagged demo == true, and anyone signed in can delete demo docs.
    match /sessions/{sid} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && (request.resource.data.athleteId == request.auth.uid
            || request.resource.data.demo == true);
      allow update: if isSignedIn()
        && resource.data.athleteId == request.auth.uid
        && request.resource.data.athleteId == request.auth.uid;
      allow delete: if isSignedIn()
        && (resource.data.athleteId == request.auth.uid
            || resource.data.demo == true);
    }

    // Invites: signed-in users can read and create codes.
    // Marking a code used may only touch the usedBy field.
    match /invites/{code} {
      allow read: if isSignedIn();
      allow create: if isSignedIn();
      allow update: if isSignedIn()
        && request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['usedBy']);
      allow delete: if false;
    }

    // Session review flags: any signed-in athlete can flag any session
    // (session docs themselves stay owner-write) and anyone can resolve.
    match /flags/{flagId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.flaggedByUid == request.auth.uid;
      allow update: if isSignedIn();
      allow delete: if false;
    }

    // Coaches' Corner posts: readable by the league, written by the
    // athlete whose account relays for their coach; the author can edit
    // or delete their own posts.
    match /coachPosts/{postId} {
      allow read: if isSignedIn();
      allow create: if isSignedIn()
        && request.resource.data.authorUid == request.auth.uid;
      allow update, delete: if isSignedIn()
        && resource.data.authorUid == request.auth.uid;
    }
  }
}
